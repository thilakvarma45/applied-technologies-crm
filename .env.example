# Google Cloud OAuth 2.0 Client ID (Web Application)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Spreadsheet ID (from your URL: https://docs.google.com/spreadsheets/d/1vp6lxbQVzoHDHov37RDtE2yJkgRUlSefV2goheAjVeQ/edit)
VITE_SPREADSHEET_ID=1vp6lxbQVzoHDHov37RDtE2yJkgRUlSefV2goheAjVeQ

# Sheet Name (Tab name at the bottom of the spreadsheet)
VITE_SHEET_NAME=Sheet1
